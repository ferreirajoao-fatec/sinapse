# =============================================================================
# Sinapse - variaveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# O arquivo .env NUNCA deve ser enviado para o Git.
# =============================================================================

NODE_ENV=development

# -----------------------------------------------------------------------------
# Banco de dados (usado pelo Docker Compose e pelo Prisma)
# -----------------------------------------------------------------------------
POSTGRES_USER=sinapse
POSTGRES_PASSWORD=troque_esta_senha_local
POSTGRES_DB=sinapse
POSTGRES_PORT=5432

DATABASE_URL="postgresql://sinapse:troque_esta_senha_local@localhost:5432/sinapse?schema=public"

# -----------------------------------------------------------------------------
# Redis (filas e cache - usado a partir da Etapa 9)
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_PORT=3333
WEB_ORIGIN=http://localhost:3000

# Gere segredos fortes com o comando abaixo (PowerShell):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=gere_um_segredo_com_o_comando_acima
JWT_REFRESH_SECRET=gere_outro_segredo_diferente
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# -----------------------------------------------------------------------------
# Frontend (apenas variaveis NEXT_PUBLIC_ chegam ao navegador)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
NEXT_PUBLIC_APP_NAME=Sinapse

# -----------------------------------------------------------------------------
# Login com Google (opcional)
# Deixe em branco e o botao "Entrar com o Google" simplesmente nao aparece.
# Os dois valores precisam ser preenchidos juntos.
# Crie as credenciais em: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/api/v1/auth/google/callback

# -----------------------------------------------------------------------------
# Envio de e-mail (opcional)
# Sem a chave, os links de verificacao e de nova senha sao impressos no
# terminal da API. Isso e suficiente para desenvolver sozinho.
# Crie a chave em: https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM="Sinapse <onboarding@resend.dev>"

# -----------------------------------------------------------------------------
# Etapas futuras - deixe em branco por enquanto
# -----------------------------------------------------------------------------
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
