# A API le o arquivo .env da RAIZ do monorepo.
# Este arquivo existe apenas como referencia do que a API consome.
# Copie a raiz: cp .env.example .env (na pasta raiz do projeto)

NODE_ENV=development
API_PORT=3333
WEB_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://sinapse:troque_esta_senha_local@localhost:5432/sinapse?schema=public"
JWT_ACCESS_SECRET=gere_um_segredo_forte
JWT_REFRESH_SECRET=gere_outro_segredo_forte
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
